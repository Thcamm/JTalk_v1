# ==========================================
# JTalk Web MVP - Production Environment Config
# ==========================================

# 1. SERVER & CLIENT SETTINGS
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 2. DATABASE CONFIGURATION (MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_CONNECTIONSTRING=mongodb+srv://db_user:db_password@cluster0.mongodb.net/jtalk?retryWrites=true&w=majority

# 3. JWT AUTHENTICATION & SECURITY
# Chuỗi bí mật ngẫu nhiên tạo bằng crypto.randomBytes(64).toString('hex')
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_min_64_chars_here
ACCESS_TOKEN_TTL=15m

# 4. FREEMIUM QUOTA CONFIGURATION
# Hạn mức luyện nói miễn phí tối đa mỗi ngày cho tài khoản Free (Mặc định: 2)
FREE_DAILY_PRACTICE_LIMIT=2

# 5. AI ENGINE - SPEECH-TO-TEXT & LLM SCORING
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Anthropic Claude (Alternative High-Precision Japanese Evaluator)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Microsoft Azure Cognitive Speech Services (High Accuracy Japanese STT)
AZURE_SPEECH_KEY=your_azure_speech_resource_key
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_LANGUAGE=ja-JP

# 6. CLOUD STORAGE (Lưu trữ Audio ghi âm)
# Tùy chọn: local | s3 | cloudinary
STORAGE_PROVIDER=local

# AWS S3 (Khi STORAGE_PROVIDER=s3)
AWS_S3_BUCKET=jtalk-audio-recordings
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary (Khi STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 7. MOMO PAYMENT GATEWAY (Gói Premium 99.000 VNĐ / 30 ngày)
MOMO_PARTNER_CODE=MOMO_TEST_PARTNER
MOMO_ACCESS_KEY=MOMO_TEST_ACCESS_KEY
MOMO_SECRET_KEY=MOMO_TEST_SECRET_KEY
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/payment/momo/callback
MOMO_IPN_URL=http://localhost:5001/api/v1/payments/momo/webhook
